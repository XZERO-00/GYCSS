<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <!-- Premium Header Area - Matches screen bg now -->
    <View
        android:id="@+id/header_bg"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:background="@color/bg_light"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Decorative floating circle for uniqueness -->
    <View
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginTop="-80dp"
        android:layout_marginEnd="-80dp"
        android:alpha="0.1"
        android:background="@drawable/bg_circle_teal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_logo_small"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginTop="56dp"
        android:src="@drawable/gycss_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_welcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/splash_subtitle"
        android:textColor="@color/teal_primary"
        android:textSize="28sp"
        android:textStyle="bold"
        android:letterSpacing="-0.02"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_logo_small" />

    <TextView
        android:id="@+id/tv_choose"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="48dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/choose_language"
        android:textColor="@color/teal_primary"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_welcome" />

    <!-- Role Cards Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@id/header_bg"
        app:layout_constraintBottom_toTopOf="@id/bottom_actions_layout"
        app:layout_constraintVertical_bias="0.2">

        <!-- Senior Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_senior"
            style="@style/Widget.Gycss.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="2dp"
            app:strokeColor="@color/divider_soft"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_senior_icon_bg"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/divider_soft"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_person"
                        app:tint="@color/text_muted" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tv_senior_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/senior_label"
                    android:textColor="@color/text_dark"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/iv_check_senior"
                    app:layout_constraintStart_toEndOf="@id/cv_senior_icon_bg"
                    app:layout_constraintTop_toTopOf="@id/cv_senior_icon_bg"
                    app:layout_constraintBottom_toTopOf="@id/tv_senior_desc"
                    app:layout_constraintVertical_chainStyle="packed" />

                <TextView
                    android:id="@+id/tv_senior_desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/select_language_desc"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toStartOf="@id/iv_check_senior"
                    app:layout_constraintStart_toStartOf="@id/tv_senior_title"
                    app:layout_constraintTop_toBottomOf="@id/tv_senior_title"
                    app:layout_constraintBottom_toBottomOf="@id/cv_senior_icon_bg" />

                <ImageView
                    android:id="@+id/iv_check_senior"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_check_circle"
                    android:visibility="gone"
                    app:tint="@color/teal_primary"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Volunteer Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_volunteer"
            style="@style/Widget.Gycss.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="2dp"
            app:strokeWidth="2dp"
            app:strokeColor="@color/divider_soft"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_volunteer_icon_bg"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/divider_soft"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_community"
                        app:tint="@color/text_muted" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tv_volunteer_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/volunteer_label"
                    android:textColor="@color/text_dark"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/iv_check_volunteer"
                    app:layout_constraintStart_toEndOf="@id/cv_volunteer_icon_bg"
                    app:layout_constraintTop_toTopOf="@id/cv_volunteer_icon_bg"
                    app:layout_constraintBottom_toTopOf="@id/tv_volunteer_desc"
                    app:layout_constraintVertical_chainStyle="packed" />

                <TextView
                    android:id="@+id/tv_volunteer_desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/find_seniors_nearby"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toStartOf="@id/iv_check_volunteer"
                    app:layout_constraintStart_toStartOf="@id/tv_volunteer_title"
                    app:layout_constraintTop_toBottomOf="@id/tv_volunteer_title"
                    app:layout_constraintBottom_toBottomOf="@id/cv_volunteer_icon_bg" />

                <ImageView
                    android:id="@+id/iv_check_volunteer"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_check_circle"
                    android:visibility="gone"
                    app:tint="@color/teal_primary"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Bottom Actions Area -->
    <LinearLayout
        android:id="@+id/bottom_actions_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tv_user_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Join our community"
            android:textColor="@color/teal_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_get_started"
            style="@style/Widget.Gycss.Button"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/btn_continue"
            android:enabled="false"
            android:alpha="0.5"
            android:textSize="16sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_arrow_forward"
            app:iconGravity="textEnd" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Empowering seniors since 2022"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
