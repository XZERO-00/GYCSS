<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.volunteer.VolunteerDashboardActivity">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/white"
            app:elevation="0dp">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:navigationIcon="@drawable/ic_menu">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/app_name"
                    android:textColor="@color/primary_teal"
                    android:textSize="@dimen/text_h3"
                    android:textStyle="bold" />
                
                 <ImageView
                    android:id="@+id/btn_notifications"
                    android:layout_width="@dimen/icon_size_standard"
                    android:layout_height="@dimen/icon_size_standard"
                    android:layout_gravity="end"
                    android:src="@drawable/ic_notifications"
                    app:tint="@color/primary_teal"
                    android:layout_marginEnd="@dimen/spacing_normal"
                    android:contentDescription="Notifications" />
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="100dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_normal">

                <!-- User Profile Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/iv_profile_pic"
                        android:layout_width="@dimen/profile_image_small"
                        android:layout_height="@dimen/profile_image_small"
                        android:scaleType="centerCrop"
                        android:src="@mipmap/ic_launcher_round"
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent"
                        app:strokeColor="@color/light_teal"
                        app:strokeWidth="1dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_normal"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_welcome_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/primary_text"
                            android:textSize="@dimen/text_h3"
                            android:textStyle="bold"
                            tools:text="Hello, Priya" />

                        <TextView
                            android:id="@+id/tv_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/secondary_text"
                            android:textSize="@dimen/text_subtitle"
                            tools:text="Status: Available" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/sw_availability"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <!-- SOS Alert Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_sos_alerts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_large"
                    app:cardBackgroundColor="@color/very_light_teal"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/warning_red"
                    app:strokeWidth="1dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="@dimen/icon_size_standard"
                                android:layout_height="@dimen/icon_size_standard"
                                android:src="@drawable/ic_sos"
                                app:tint="@color/warning_red"
                                android:contentDescription="Emergency" />
                            <TextView
                                android:id="@+id/tv_sos_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_small"
                                android:textColor="@color/primary_text"
                                android:textStyle="bold"
                                tools:text="Rajesh Kumar needs help" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_sos_distance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_tiny"
                            android:textColor="@color/secondary_text"
                            android:textSize="@dimen/text_caption"
                            tools:text="Active Now" />

                        <LinearLayout
                            android:id="@+id/layout_sos_actions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_normal"
                            android:orientation="horizontal">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_accept_sos"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="@dimen/spacing_small"
                                android:backgroundTint="@color/primary_teal"
                                android:text="Accept" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_reject_sos"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/spacing_small"
                                android:text="Decline"
                                app:strokeColor="@color/divider_gray" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Stats -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_large"
                    android:orientation="horizontal">
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/spacing_small"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/off_white"
                        app:cardCornerRadius="@dimen/card_corner_radius">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_normal">
                            <TextView
                                android:id="@+id/tv_helped_count_stat"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/primary_teal"
                                android:textSize="@dimen/text_h2"
                                android:textStyle="bold"
                                tools:text="0" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Helped"
                                android:textSize="@dimen/text_caption" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/off_white"
                        app:cardCornerRadius="@dimen/card_corner_radius">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_normal">
                            <TextView
                                android:id="@+id/tv_rating_stat"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/success_green"
                                android:textSize="@dimen/text_h2"
                                android:textStyle="bold"
                                tools:text="0.0" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rating"
                                android:textSize="@dimen/text_caption" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quick Actions"
                    android:textColor="@color/primary_text"
                    android:textStyle="bold"
                    android:layout_marginTop="@dimen/spacing_large"
                    android:layout_marginBottom="@dimen/spacing_small"/>

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:useDefaultMargins="false">

                    <LinearLayout
                        android:id="@+id/btn_events"
                        style="@style/DashboardIconContainer">
                        <com.google.android.material.card.MaterialCardView style="@style/DashboardIconCard">
                            <ImageView
                                android:layout_width="@dimen/spacing_xlarge"
                                android:layout_height="@dimen/spacing_xlarge"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_help_history"
                                app:tint="@color/primary_teal" />
                        </com.google.android.material.card.MaterialCardView>
                        <TextView style="@style/DashboardIconLabel" android:text="Browse\nEvents" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_help_history"
                        style="@style/DashboardIconContainer">
                        <com.google.android.material.card.MaterialCardView style="@style/DashboardIconCard">
                            <ImageView
                                android:layout_width="@dimen/spacing_xlarge"
                                android:layout_height="@dimen/spacing_xlarge"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_community"
                                app:tint="@color/primary_teal" />
                        </com.google.android.material.card.MaterialCardView>
                        <TextView style="@style/DashboardIconLabel" android:text="Help\nHistory" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_community"
                        style="@style/DashboardIconContainer">
                        <com.google.android.material.card.MaterialCardView style="@style/DashboardIconCard">
                            <ImageView
                                android:layout_width="@dimen/spacing_xlarge"
                                android:layout_height="@dimen/spacing_xlarge"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_help_finder"
                                app:tint="@color/primary_teal" />
                        </com.google.android.material.card.MaterialCardView>
                        <TextView style="@style/DashboardIconLabel" android:text="Community\nForum" />
                    </LinearLayout>
                </GridLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/white"
            app:itemIconTint="@color/secondary_text"
            app:itemTextColor="@color/secondary_text"
            app:menu="@menu/bottom_nav_menu_volunteer" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/drawer_menu_volunteer" />

</androidx.drawerlayout.widget.DrawerLayout>
