<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Gycss2" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors mapped to the new Premium Palette -->
        <item name="colorPrimary">@color/teal_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/teal_light</item>
        <item name="colorOnPrimaryContainer">@color/teal_primary</item>
        
        <item name="colorSecondary">@color/navy_primary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/teal_light</item>
        <item name="colorOnSecondaryContainer">@color/teal_primary</item>

        <item name="colorTertiary">@color/status_online</item>
        <item name="colorOnTertiary">@color/white</item>

        <item name="colorError">@color/sos_red</item>
        <item name="colorOnError">@color/white</item>

        <!-- Backgrounds & Surfaces -->
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="colorSurface">@color/surface_white</item>
        <item name="colorOnSurface">@color/text_dark</item>
        <item name="colorSurfaceVariant">@color/bg_light</item>
        <item name="colorOnSurfaceVariant">@color/text_muted</item>
        <item name="colorOutline">@color/divider_soft</item>

        <!-- Status Bar & Navigation Bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/surface_white</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="Theme.Gycss2" parent="Base.Theme.Gycss2" />

    <!-- Reusable Component Styles -->
    <style name="Widget.Gycss.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>

    <style name="Widget.Gycss.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/divider_soft</item>
        <item name="hintTextColor">@color/teal_primary</item>
    </style>

    <style name="Widget.Gycss.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/divider_soft</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Perfect Pill Shape Appearance -->
    <style name="ShapeAppearance.Gycss.BottomBar" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">40dp</item>
    </style>

    <style name="Theme.Gycss2.Splash" parent="Theme.Gycss2">
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>
</resources>
