<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Gycss2" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/primary_teal</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/light_teal</item>
        <item name="colorOnPrimaryContainer">@color/primary_text</item>
        
        <item name="colorSecondary">@color/dark_teal</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/very_light_teal</item>
        <item name="colorOnSecondaryContainer">@color/primary_text</item>

        <item name="colorTertiary">@color/success_green</item>
        <item name="colorOnTertiary">@color/white</item>

        <!-- Backgrounds -->
        <item name="android:windowBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/primary_text</item>
        <item name="colorSurfaceVariant">@color/off_white</item>
        <item name="colorOnSurfaceVariant">@color/secondary_text</item>
        <item name="colorOutlineVariant">@color/divider_gray</item>

        <item name="colorSurfaceContainer">@color/off_white</item>
        <item name="dividerColor">@color/divider_gray</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/primary_teal</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Gycss2" parent="Base.Theme.Gycss2" />
    
    <style name="Theme.Gycss2.Splash" parent="Theme.Gycss2">
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>

    <!-- Shape Appearance Overlays -->
    <style name="ShapeAppearanceOverlay.App.CornerSize50Percent" parent="">
        <item name="cornerSize">50%</item>
    </style>
</resources>